# Copy this file to .env and fill in your own provider credentials.
# Never commit a real .env file.

AGENTCLI_PROVIDER=deepseek
AGENTCLI_MODEL=deepseek-v4-flash

# Option 1: provider-specific key
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Option 2: generic OpenAI-compatible key
# AGENTCLI_API_KEY=your_api_key_here
# AGENTCLI_BASE_URL=https://api.deepseek.com

# Optional Runtime API key for `agentcli serve`
AGENTCLI_RUNTIME_API_KEY=change_me_for_local_development
